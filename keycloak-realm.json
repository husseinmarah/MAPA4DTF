{
  "id": "warehouse-federation",
  "realm": "warehouse-federation",
  "enabled": true,
  "clients": [
    {
      "clientId": "warehouse-client",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["email", "profile", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "org",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "org",
            "jsonType.label": "String"
          }
        },
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "role",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "trustScore",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "trustScore",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "trustScore",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "FederationAgentManager",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "federation", "temporary": false }],
      "attributes": {
        "org": ["main"],
        "role": ["federation_manager"],
        "trustScore": ["1.0"]
      }
    },
    {
      "username": "ProductionAgentManager",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "production", "temporary": false }],
      "attributes": {
        "org": ["main"],
        "role": ["manager"],
        "trustScore": ["0.95"]
      }
    },
    {
      "username": "RobotAgent_Stakeholder1",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "robot", "temporary": false }],
      "attributes": {
        "org": ["Stakeholder1_RobotContainer"],
        "role": ["worker"],
        "trustScore": ["0.85"]
      }
    },
    {
      "username": "RobotAgent_Stakeholder2",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "robot", "temporary": false }],
      "attributes": {
        "org": ["Stakeholder2_RobotContainer"],
        "role": ["worker"],
        "trustScore": ["0.9"]
      }
    },
    {
      "username": "ConveyorAgent_Stakeholder3",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "conveyor", "temporary": false }],
      "attributes": {
        "org": ["Stakeholder3_ConveyorContainer"],
        "role": ["worker"],
        "trustScore": ["0.8"]
      }
    }
  ]
}
